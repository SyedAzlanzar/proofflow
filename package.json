{
  "name": "proofflow",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@proofflow/web",
    "dev:api": "npm run dev --workspace=@proofflow/api",
    "build": "npm run build --workspace=@proofflow/shared && npm run build --workspace=@proofflow/api"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}